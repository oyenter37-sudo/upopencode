#!/usr/bin/env bash
#
# upopencode — OpenCode v2 installer/updater for Termux (glibc build).
# Installs from scratch, updates and migrates v1 → v2: checks the latest release,
# downloads the linux asset for the phone architecture, verifies SHA-256,
# patches the interpreter and installs atomically.
#
set -uo pipefail

# running as upopencode-ru switches to the Russian build (same code)
case "$(basename "$0")" in
  upopencode-ru) PROG="upopencode-ru" ;;
  *)             PROG="upopencode" ;;
esac
SELF_VERSION="1.5.0"
REPO="anomalyco/opencode"
NPM_URL="https://registry.npmjs.org/@opencode%2Fcli/latest"
NPM_DIST_TAGS="https://registry.npmjs.org/-/package/@opencode%2Fcli/dist-tags"
GH_API="https://api.github.com/repos/${REPO}"
# this project (for --self-update and install)
GH_SLUG="oyenter37-sudo/upopencode"
GH_BRANCH="main"
RAW_BASE="https://raw.githubusercontent.com/${GH_SLUG}/${GH_BRANCH}"

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
OC_DIR="$XDG_DATA_HOME/opencode2"
REAL="$OC_DIR/opencode.real"
LAUNCHER="$OC_DIR/opencode"
VERSION_FILE="$OC_DIR/VERSION"
BACKUP="$OC_DIR/opencode.real.backup"
TMP_BASE="${TMPDIR:-$PREFIX/tmp}"

# Detect Termux from the environment, not from glibc being present:
# a fresh Termux has no glibc, but the build still must be installed and patched.
TERMUX=0
if [ -n "${TERMUX_VERSION:-}" ] || [ -x "$PREFIX/bin/pkg" ] || [ "$(uname -o 2>/dev/null)" = "Android" ]; then
  TERMUX=1
fi

case "$(uname -m)" in
  aarch64|arm64) ARCH="arm64"; GLIBC_LD="$PREFIX/glibc/lib/ld-linux-aarch64.so.1" ;;
  x86_64|amd64)  ARCH="x64";   GLIBC_LD="$PREFIX/glibc/lib/ld-linux-x86-64.so.2" ;;
  *) ARCH="" ;;
esac

if [ "$TERMUX" = 1 ]; then BIN_DIR="$PREFIX/bin"; else BIN_DIR="$HOME/.local/bin"; fi

# where the script is installed — the upoc short name points to it
SELF_BIN="$BIN_DIR/$PROG"
ALIAS_DEFAULT="oc"
ALIAS_NAME=""
ALIAS_ACTION=""

# ---------- arguments ----------
CHECK=0; DRYRUN=0; ASSUME_YES=0; FORCE=0; RESTART=0; DO_CLEAN=0
SELF_UPDATE=0; UNINSTALL=0; UNINSTALL_OC=0
BACKUP_MODE="ask"   # ask | yes | no
NO_COLOR="${NO_COLOR:-}"

usage() {
  cat <<EOF
$PROG $SELF_VERSION — OpenCode v2 updater

Usage: $PROG [options]

  (no options)    install or update (with menu)
  -c, --check     check versions only (change nothing)
  -n, --dry-run   show the plan and disk space, download nothing
  -y, --yes       no prompts (no backup)
  -f, --force     reinstall even if the version is the same
  -r, --restart   restart the background service after updating
      --backup    always keep a backup of the old version
      --no-backup never keep a backup
      --clean     delete old backups and temp files
      --self-update
                  update upopencode itself from GitHub
      --uninstall remove upopencode itself (keep OpenCode)
      --uninstall-opencode
                  remove OpenCode v2, the launcher and short names
      --alias [set|show|remove] [name]
                  short command name to launch OpenCode,
                  e.g. --alias set code  →  the command code
      --no-color  no colors
  -h, --help      this help
  -v, --version   version of this script
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -c|--check)     CHECK=1 ;;
    -n|--dry-run)   DRYRUN=1 ;;
    -y|--yes)       ASSUME_YES=1 ;;
    -f|--force)     FORCE=1 ;;
    -r|--restart)   RESTART=1 ;;
    --backup)       BACKUP_MODE="yes" ;;
    --no-backup)    BACKUP_MODE="no" ;;
    --clean)        DO_CLEAN=1 ;;
    --self-update|--selfupdate|--update-self) SELF_UPDATE=1 ;;
    --uninstall|--remove) UNINSTALL=1 ;;
    --uninstall-opencode|--remove-opencode) UNINSTALL_OC=1 ;;
    --alias)        ALIAS_ACTION="show"
                    if [ $# -ge 2 ]; then
                      case "$2" in
                        -*) ;;
                        show)
                          ALIAS_ACTION="show"; shift ;;
                        set|add|create|remove|rm|del|delete)
                          ALIAS_ACTION="$2"; shift
                          if [ $# -ge 2 ]; then
                            case "$2" in -*) ;; *) ALIAS_NAME="$2"; shift ;; esac
                          fi ;;
                        *)
                          ALIAS_ACTION="set"; ALIAS_NAME="$2"; shift ;;
                      esac
                    fi ;;
    --alias=*)      ALIAS_ACTION="${1#*=}" ;;
    --no-color)     NO_COLOR=1 ;;
    -h|--help)      usage; exit 0 ;;
    -v|--version)   printf '%s %s\n' "$PROG" "$SELF_VERSION"; exit 0 ;;
    *) printf 'Unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

# ---------- colors ----------
TTY=0; [ -t 1 ] && [ -t 0 ] && TTY=1
if [ "$TTY" = 1 ] && [ -z "$NO_COLOR" ]; then
  RST=$'\033[0m'; BOLD=$'\033[1m'; DIM=$'\033[2m'
  CY=$'\033[38;5;51m'; MG=$'\033[38;5;213m'; GR=$'\033[38;5;46m'
  RD=$'\033[38;5;203m'; YL=$'\033[38;5;220m'; GY=$'\033[38;5;245m'
  WH=$'\033[97m'
else
  RST=""; BOLD=""; DIM=""; CY=""; MG=""; GR=""; RD=""; YL=""; GY=""; WH=""
fi

if [ -z "$ARCH" ]; then
  printf 'Unsupported architecture %s: official builds exist only for arm64 and x64.\n' "$(uname -m)" >&2
  exit 2
fi
ASSET="opencode-linux-${ARCH}.tar.gz"
# show a short name like opencode-... inside the box
ASSET_SHORT="${ASSET%%-*}"
if [ "$ASSET_SHORT" != "$ASSET" ]; then
  ASSET_SHORT="$ASSET_SHORT-..."
else
  ASSET_SHORT="${ASSET:0:5}..."
fi

# box width follows the screen (at least 30, at most 52)
term_cols() {
  local c="${COLUMNS:-0}"
  case "$c" in ''|*[!0-9]*) c=0 ;; esac
  [ "$c" -le 0 ] && c=$(tput cols 2>/dev/null || echo 0)
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [ "$c" -le 0 ] && c=80
  printf '%s' "$c"
}
BOX_W=$(( $(term_cols) - 4 ))
[ "$BOX_W" -gt 52 ] && BOX_W=52
[ "$BOX_W" -lt 30 ] && BOX_W=30

# ---------- helpers ----------
TMP_DIR=""; SPIN_PID=""; STEP=0; STEPS=0; LABEL=""
MOUSE_ON=0; MENU_RESULT=-1

cleanup() {
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$MOUSE_ON" = 1 ]; then printf '\033[?1000l\033[?1006l'; MOUSE_ON=0; fi
  [ "$TTY" = 1 ] && printf '\033[?25h'
  [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR"
}
trap cleanup EXIT
trap 'printf "\n"; exit 130' INT TERM

die() {
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  [ "$TTY" = 1 ] && printf '\r\033[K'
  printf '%s✖%s %s\n' "$RD" "$RST" "$1" >&2
  [ -n "${2:-}" ] && printf '%s\n' "$2" >&2
  exit 1
}

fmt_size() {
  local b=${1:-0}
  if [ "$b" -ge 1073741824 ]; then
    printf '%d.%d GiB' $((b/1073741824)) $(( (b%1073741824)*10/1073741824 ))
  elif [ "$b" -ge 1048576 ]; then
    printf '%d.%d MiB' $((b/1048576)) $(( (b%1048576)*10/1048576 ))
  elif [ "$b" -ge 1024 ]; then
    printf '%d KiB' $((b/1024))
  else
    printf '%d B' "$b"
  fi
}

free_kb() { df -Pk "$1" 2>/dev/null | awk 'NR==2 {print $4}'; }

# visible line width in characters (strip ANSI, count UTF-8 lead bytes)
vlen() {
  printf '%s' "$1" | sed 's/\x1b\[[0-9;]*m//g' | od -An -v -tu1 \
    | awk '{for(i=1;i<=NF;i++){b=$i+0; if(b<128||b>=192)n++}} END{printf "%d", n+0}'
}

box_top() { # $1 = title
  local t="$1" d i
  d=$(( BOX_W - 3 - $(vlen "$t") )); [ "$d" -lt 1 ] && d=1
  printf '  %s┌─%s %s%s%s ' "$GY" "$RST" "$BOLD" "$t" "$RST"
  for ((i=0; i<d; i++)); do printf '─'; done
  printf '%s┐%s\n' "$GY" "$RST"
}

box_row() { # $1 = text (may contain colors)
  local text="$1" len pad max
  len=$(vlen "$text")
  if [ "$len" -gt $(( BOX_W - 1 )) ]; then        # too wide: strip colors and trim
    text=$(printf '%s' "$text" | sed 's/\x1b\[[0-9;]*m//g')
    max=$(( BOX_W - 3 )); len=$(vlen "$text")
    if [ "$len" -gt "$max" ]; then text="${text:0:$max}…"; len=$(( max + 1 )); fi
  fi
  pad=$(( BOX_W - 1 - len )); [ "$pad" -lt 0 ] && pad=0
  printf '  %s│%s %s%*s%s│%s\n' "$GY" "$RST" "$text" "$pad" '' "$GY" "$RST"
}

box_bottom() {
  local i
  printf '  %s└' "$GY"
  for ((i=0; i<BOX_W; i++)); do printf '─'; done
  printf '┘%s\n' "$RST"
}

gtext() { # ASCII gradient
  local s="$1" i
  if [ "$TTY" != 1 ] || [ -n "$NO_COLOR" ]; then printf '%s' "$s"; return; fi
  local cols=(45 51 87 123 159 195 213)
  for ((i=0; i<${#s}; i++)); do
    printf '\033[38;5;%dm%s' "${cols[$((i % ${#cols[@]}))]}" "${s:i:1}"
  done
  printf '%s' "$RST"
}

banner() {
  printf '\n'
  printf '  %s⬢%s  %s\n' "$MG" "$RST" "$(gtext upopencode)"
  printf '  %s──────────────────────────────────────%s\n' "$GY" "$RST"
  printf '  %sOpenCode updater · Termux / glibc%s\n\n' "$DIM" "$RST"
}

# ---------- steps ----------
SPIN_FRAMES=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
spin_loop() {
  local i=0
  while :; do
    printf '\r\033[K  %s%s%s %s[%d/%d]%s %s…' \
      "$CY" "${SPIN_FRAMES[i]}" "$RST" "$GY" "$STEP" "$STEPS" "$RST" "$LABEL"
    i=$(( (i+1) % 10 ))
    sleep 0.08
  done
}
step_start() {
  STEP=$((STEP+1)); LABEL="$1"
  if [ "$TTY" = 1 ]; then spin_loop & SPIN_PID=$!; else printf '  [%d/%d] %s…\n' "$STEP" "$STEPS" "$LABEL"; fi
}
stop_spin() { # stop the spinner (otherwise it fights the progress bar)
  if [ -n "$SPIN_PID" ]; then
    kill "$SPIN_PID" 2>/dev/null
    wait "$SPIN_PID" 2>/dev/null
    SPIN_PID=""
  fi
  [ "$TTY" = 1 ] && printf '\r\033[K'
}
step_ok() {
  local note="${1:-}"
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$TTY" = 1 ]; then
    printf '\r\033[K  %s✔%s %s[%d/%d]%s %s' "$GR" "$RST" "$GY" "$STEP" "$STEPS" "$RST" "$LABEL"
    [ -n "$note" ] && printf ' %s· %s%s' "$DIM" "$note" "$RST"
    printf '\n'
  else
    printf '  [%d/%d] %s: ok%s\n' "$STEP" "$STEPS" "$LABEL" "${note:+ ($note)}"
  fi
}
step_fail() {
  local note="${1:-}"
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$TTY" = 1 ]; then
    printf '\r\033[K  %s✖%s %s[%d/%d]%s %s' "$RD" "$RST" "$GY" "$STEP" "$STEPS" "$RST" "$LABEL"
    [ -n "$note" ] && printf ' %s· %s%s' "$DIM" "$note" "$RST"
    printf '\n'
  else
    printf '  [%d/%d] %s: FAIL%s\n' "$STEP" "$STEPS" "$LABEL" "${note:+ ($note)}"
  fi
}

# ---------- versions ----------
probe_version() { # $1 = path to the binary/launcher; prints x.y.z or nothing
  local p="$1" v=""
  [ -n "$p" ] && [ -x "$p" ] || return 0
  v=$(timeout 25 "$p" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  if [ -z "$v" ]; then
    v=$(env -u LD_PRELOAD timeout 25 "$p" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  fi
  printf '%s' "$v"
}

# Sets the global CUR_VER and BROKEN (not via $(...), otherwise the flag is lost).
installed_version() {
  local p=""
  CUR_VER=""; BROKEN=0
  if [ -x "$REAL" ]; then
    CUR_VER=$(probe_version "$REAL")
    [ -z "$CUR_VER" ] && BROKEN=1        # file exists but does not start — reinstall
    return
  fi
  if [ -f "$VERSION_FILE" ]; then CUR_VER=$(<"$VERSION_FILE"); fi
  # OpenCode may be installed on its own (v1 from npm or an old install)
  if [ -z "$CUR_VER" ]; then
    for p in "$(command -v opencode2 2>/dev/null || true)" "$(command -v opencode 2>/dev/null || true)"; do
      [ -n "$p" ] || continue
      CUR_VER=$(probe_version "$p")
      [ -n "$CUR_VER" ] && break
    done
  fi
  CUR_VER="${CUR_VER#v}"
}

http_get() { # $1 = url -> HTTP_BODY, HTTP_RC
  HTTP_BODY=$(curl -fsSL --connect-timeout 5 --max-time 10 --retry 1 --retry-delay 1 "$1" 2>/dev/null)
  HTTP_RC=$?
}

latest_version() {
  local v="" deadline=$((SECONDS + 40))
  # 1) npm dist-tags — the shortest unambiguous answer
  http_get "$NPM_DIST_TAGS"
  v=$(printf '%s' "$HTTP_BODY" | grep -o '"latest"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | cut -d'"' -f4)
  case "$v" in *[!0-9.]*|'') v="" ;; esac

  # 2) GitHub releases atom feed — no API limits
  if [ -z "$v" ] && [ "$SECONDS" -lt "$deadline" ]; then
    http_get "https://github.com/${REPO}/releases.atom"
    v=$(printf '%s' "$HTTP_BODY" | grep -o 'releases/tag/v[0-9][0-9.]*' | sed 's#.*/v##' \
        | grep -E '^2\.[0-9]+\.[0-9]+$' | sort -V | tail -1)
  fi

  # 3) GitHub API
  if [ -z "$v" ] && [ "$SECONDS" -lt "$deadline" ]; then
    http_get "$GH_API/releases?per_page=30"
    v=$(printf '%s' "$HTTP_BODY" | grep -o '"tag_name":"v2\.[^"]*"' | cut -d'"' -f4 | sed 's/^v//' | sort -V | tail -1)
  fi

  case "$v" in *[!0-9.]*|'') v="" ;; esac
  printf '%s' "$v"
}

release_date() {
  http_get "$GH_API/releases/tags/v$1"
  printf '%s' "$HTTP_BODY" | grep -o '"published_at":"[^"]*"' | head -1 | cut -d'"' -f4 | cut -dT -f1
}

version_gt() { # $1 > $2 ?
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | tail -1)" = "$1" ]
}

# ---------- input: keys, mouse, DSR ----------
KEY=""; MOUSE_TERM=""; MOUSE_B=0; MOUSE_X=0; MOUSE_Y=0
MENU_ROW=0; MENU_BLOCK_ROW=0

read_key() {
  local c c2 c3 seq body term cb cx cy
  KEY=""
  if ! IFS= read -rsn1 -t 0.1 c; then KEY="timeout"; return; fi
  # Enter: bash -n returns an empty string with rc 0 (newline is the delimiter)
  if [ -z "$c" ]; then KEY="enter"; return; fi
  case "$c" in
    $'\n'|$'\r') KEY="enter" ;;
    $'\e')
      if ! IFS= read -rsn1 -t 0.05 c2; then KEY="esc"; return; fi
      case "$c2" in
        '['|'O')
          if ! IFS= read -rsn1 -t 0.05 c3; then KEY="esc"; return; fi
          case "$c3" in
            A) KEY="up" ;;
            B) KEY="down" ;;
            C) KEY="right" ;;
            D) KEY="left" ;;
            H) KEY="home" ;;
            F) KEY="end" ;;
            '<')
              seq=""
              while IFS= read -rsn1 -t 0.05 c2; do
                [ -z "$c2" ] && break
                seq+="$c2"
                case "$c2" in M|m) break ;; esac
                [ ${#seq} -gt 24 ] && break
              done
              term="${seq: -1}"; body="${seq%?}"
              IFS=';' read -r cb cx cy <<< "$body"
              MOUSE_TERM="$term"; MOUSE_B="${cb:-0}"; MOUSE_X="${cx:-0}"; MOUSE_Y="${cy:-0}"
              KEY="mouse" ;;
            *) KEY="other" ;;
          esac ;;
        *) KEY="esc" ;;
      esac ;;
    [1-9]) KEY="num:$c" ;;
    [jJ]) KEY="down" ;;
    [kK]) KEY="up" ;;
    [qQ]) KEY="quit" ;;
    *) KEY="other" ;;
  esac
}

query_row() { # current cursor row -> MENU_ROW
  local ch resp="" i=0
  MENU_ROW=0
  printf '\033[6n'
  while [ $i -lt 40 ]; do
    if ! IFS= read -rsn1 -t 0.2 ch; then break; fi
    resp+="$ch"; i=$((i+1))
    [ "$ch" = "R" ] && break
  done
  case "$resp" in
    *'['*';'*R)
      local t="${resp##*[}"
      MENU_ROW="${t%%;*}"
      case "$MENU_ROW" in ''|*[!0-9]*) MENU_ROW=0 ;; esac ;;
  esac
}

menu_select() { # $1 title, then the options; result in MENU_RESULT
  local title="$1"; shift
  local -a opts=("$@")
  local n=${#opts[@]}
  local sel=0 first=1 i

  MENU_RESULT=-1
  if [ "$TTY" != 1 ]; then MENU_RESULT=0; return; fi

  # reserve lines so the block does not scroll, and learn our row
  MENU_BLOCK_ROW=0
  for ((i=0; i<n+3; i++)); do printf '\n'; done
  query_row
  printf '\033[%dA' "$((n+3))"
  if [ "$MENU_ROW" -gt 0 ]; then
    MENU_BLOCK_ROW=$((MENU_ROW - (n+3)))
    printf '\033[?1000h\033[?1006h'
    MOUSE_ON=1
  else
    # terminal has no DSR (or did not answer): tap is unavailable, keys still work
    printf '\033[J'
  fi

  _menu_draw() {
    [ "$first" = 1 ] || printf '\033[%dA' "$((n+2))"
    first=0
    printf '\r\033[K  %s?%s %s%s%s\n' "$YL" "$RST" "$BOLD" "$title" "$RST"
    for ((i=0; i<n; i++)); do
      if [ $i -eq $sel ]; then
        printf '\r\033[K  %s▸ %s%s\n' "$CY$BOLD" "${opts[i]}" "$RST"
      else
        printf '\r\033[K    %s%s%s\n' "$GY" "${opts[i]}" "$RST"
      fi
    done
    printf '\r\033[K  %s↑/↓ · Enter · tap an option%s\n' "$DIM" "$RST"
  }

  _menu_draw
  while :; do
    read_key
    case "$KEY" in
      up)   sel=$(( (sel-1+n) % n )); _menu_draw ;;
      down) sel=$(( (sel+1) % n )); _menu_draw ;;
      enter) MENU_RESULT=$sel; break ;;
      num:*)
        i=$(( ${KEY#num:} - 1 ))
        if [ $i -ge 0 ] && [ $i -lt $n ]; then sel=$i; MENU_RESULT=$i; _menu_draw; break; fi ;;
      mouse)
        if [ "$MOUSE_TERM" = "M" ]; then
          if [ "$MOUSE_B" -eq 64 ]; then
            sel=$(( (sel-1+n) % n )); _menu_draw
          elif [ "$MOUSE_B" -eq 65 ]; then
            sel=$(( (sel+1) % n )); _menu_draw
          elif [ $(( MOUSE_B & 3 )) -eq 0 ] && [ "$MENU_BLOCK_ROW" -gt 0 ]; then
            i=$(( MOUSE_Y - MENU_BLOCK_ROW - 1 ))
            if [ $i -ge 0 ] && [ $i -lt $n ]; then
              sel=$i; MENU_RESULT=$i; _menu_draw; break
            fi
          fi
        fi ;;
      esc|quit) MENU_RESULT=-1; break ;;
    esac
  done

  if [ "$MOUSE_ON" = 1 ]; then printf '\033[?1000l\033[?1006l'; MOUSE_ON=0; fi
  printf '\n'
}

# ---------- freeing space ----------
du_bytes() { [ -e "$1" ] && du -sk "$1" 2>/dev/null | awk '{print $1*1024}' || echo 0; }

do_clean() { # $1=1 — without a second confirmation (the caller already asked)
  local auto=${1:-0} total=0 f kb
  printf '\n  %sCan be removed%s\n' "$BOLD" "$RST"
  for f in "$BACKUP" "$OC_DIR"/*.bak "$OC_DIR"/*.prev; do
    [ -e "$f" ] || continue
    kb=$(du -sk "$f" 2>/dev/null | awk '{print $1}')
    printf '    %s%-46s%s %s\n' "$GY" "$(basename "$f")" "$RST" "$(fmt_size $((kb*1024)))"
    total=$((total + kb*1024))
  done
  for f in "$TMP_BASE"/upopencode.*; do
    [ -e "$f" ] || continue
    [ -n "$TMP_DIR" ] && [ "$f" = "$TMP_DIR" ] && continue   # do not touch the current run
    kb=$(du -sk "$f" 2>/dev/null | awk '{print $1}')
    printf '    %s%-46s%s %s\n' "$GY" "$(basename "$f")" "$RST" "$(fmt_size $((kb*1024)))"
    total=$((total + kb*1024))
  done
  if [ "$total" -eq 0 ]; then
    printf '    %snothing to remove%s\n' "$DIM" "$RST"
    return 0
  fi
  printf '\n  %sTotal: %s%s\n' "$BOLD" "$(fmt_size "$total")" "$RST"
  if [ "$auto" != 1 ]; then
    menu_select "Delete this?" "Yes, free $(fmt_size "$total")" "No, cancel"
    [ "$MENU_RESULT" = 0 ] || { printf '  %sCancelled%s\n\n' "$DIM" "$RST"; return 0; }
  fi
  rm -f "$BACKUP"
  rm -f "$OC_DIR"/*.bak "$OC_DIR"/*.prev 2>/dev/null
  if [ -n "$TMP_DIR" ]; then
    find "$TMP_BASE" -maxdepth 1 -name 'upopencode.*' ! -path "$TMP_DIR" -exec rm -rf {} + 2>/dev/null
  else
    rm -rf "$TMP_BASE"/upopencode.* 2>/dev/null
  fi
  printf '  %s✔%s Freed ~%s\n\n' "$GR" "$RST" "$(fmt_size "$total")"
}

# ---------- download with progress ----------
draw_bar() { # cur total start_us — the whole progress line, no wrapping
  local cur=$1 total=$2 start_us=$3
  local now_us elapsed_ms speed pct cols barw left right filled empty i bf="" be=""
  now_us=${EPOCHREALTIME/./}
  elapsed_ms=$(( (now_us - start_us) / 1000 )); [ "$elapsed_ms" -lt 1 ] && elapsed_ms=1
  speed=$(( cur * 1000 / elapsed_ms ))
  cols=$(term_cols)

  if [ "$total" -gt 0 ]; then
    pct=$(( cur * 100 / total )); [ "$pct" -gt 100 ] && pct=100
  else
    pct=0
  fi

  # single line: "↓ [3/7] ████░░░░ 42%  47.2 MiB / 112.4 MiB"
  left="  ↓ [${STEP}/${STEPS}] "
  right=" $(printf '%3d' "$pct")%  $(fmt_size "$cur") / $(fmt_size "$total")"
  barw=$(( cols - $(vlen "$left") - $(vlen "$right") - 1 ))
  if [ "$barw" -lt 6 ]; then                     # narrow screen — shrink the labels
    left="  ↓ "
    right=" $(printf '%3d' "$pct")%  $(fmt_size "$cur")"
    barw=$(( cols - $(vlen "$left") - $(vlen "$right") - 1 ))
  fi
  [ "$barw" -gt 24 ] && barw=24
  [ "$barw" -lt 4 ] && barw=4

  filled=$(( pct * barw / 100 )); empty=$(( barw - filled ))
  for ((i=0; i<filled; i++)); do bf+="█"; done
  for ((i=0; i<empty; i++)); do be+="░"; done

  [ "$TTY" = 1 ] || return 0
  printf '\r\033[K%s%s%s%s%s%s%s%s%s%s' \
    "$GY" "$left" "$RST" "$CY" "$bf" "$RST" "$DIM" "$be" "$RST" "$right"
  if [ "$total" -le 0 ] || [ "$cols" -ge 84 ]; then
    printf '  %s%s/s%s' "$DIM" "$(fmt_size "$speed")" "$RST"
  fi
}

download_asset() { # url out
  local url="$1" out="$2" total pid rc cur start_us last_pct=-10 pct
  total=$(curl -fsIL --connect-timeout 10 --retry 2 "$url" 2>/dev/null | tr -d '\r' \
          | awk 'tolower($1)=="content-length:" {v=$2} END {print v}')
  case "$total" in ''|*[!0-9]*) total=0 ;; esac
  stop_spin            # single line: the spinner gives way to the progress bar
  : > "$out"
  curl -fL --retry 3 --retry-delay 2 --connect-timeout 20 -sS -o "$out" "$url" 2>"${TMP_DIR}/curl.err" &
  pid=$!
  start_us=${EPOCHREALTIME/./}
  while kill -0 "$pid" 2>/dev/null; do
    cur=$(stat -c%s "$out" 2>/dev/null || echo 0)
    if [ "$TTY" = 1 ]; then draw_bar "$cur" "$total" "$start_us"
    elif [ "$total" -gt 0 ]; then
      pct=$(( cur * 100 / total ))
      if [ $((pct/10)) -ne $((last_pct/10)) ]; then last_pct=$pct; printf '      %d%% (%s)\n' "$pct" "$(fmt_size "$cur")"; fi
    fi
    sleep 0.15
  done
  wait "$pid"; rc=$?
  cur=$(stat -c%s "$out" 2>/dev/null || echo 0)
  if [ "$rc" -ne 0 ]; then
    die "Failed to download $url" "$(tail -3 "${TMP_DIR}/curl.err" 2>/dev/null)"
  fi
  # final frame on the same line — step_ok replaces it with a checkmark
  [ "$TTY" = 1 ] && draw_bar "$cur" "${total:-$cur}" "$start_us"
  DOWNLOADED_BYTES=$cur
}

# ---------- install ----------
write_launcher() {
  mkdir -p "$OC_DIR"
  {
    if [ "$TERMUX" = 1 ]; then
      printf '#!%s/bin/bash\n' "$PREFIX"
    else
      printf '#!/usr/bin/env bash\n'
    fi
    printf '# OpenCode v2 launcher (generated %s)\n' "$PROG"
    if [ "$TERMUX" = 1 ]; then
      printf '# the glibc binary is incompatible with Termux LD_PRELOAD\n'
      printf 'unset LD_PRELOAD\n'
    fi
    printf 'exec "%s" "$@"\n' "$REAL"
  } > "$LAUNCHER"
  chmod 755 "$LAUNCHER"
}

link_commands() {
  local name path v1 v
  v1="$BIN_DIR/opencode-v1"
  for name in opencode2 opencode oc; do
    path="$BIN_DIR/$name"
    if [ -L "$path" ]; then
      if [ "$(readlink -f "$path")" != "$LAUNCHER" ]; then
        # foreign symlink (e.g. v1 from npm): keep it reachable as opencode-v1
        if [ "$name" = "opencode" ] && [ ! -e "$v1" ] && [ ! -L "$v1" ]; then
          mv "$path" "$v1" 2>/dev/null || true
        fi
        ln -sfn "$LAUNCHER" "$path"
      fi
    elif [ -e "$path" ]; then
      if [ "$name" = "opencode" ]; then
        v=$(probe_version "$path")
        case "$v" in
          1.*)
            if [ ! -e "$v1" ] && [ ! -L "$v1" ]; then
              mv "$path" "$v1" && printf '  %s↳%s the old v1 was kept as %s\n' "$GY" "$RST" "$v1"
            else
              rm -f "$path"
            fi
            ln -s "$LAUNCHER" "$path" && printf '  %s↳%s opencode now runs v2\n' "$GY" "$RST"
            ;;
          *)
            printf '  %s!%s %s already exists and is not a symlink — left as is\n' "$YL" "$RST" "$path"
            ;;
        esac
      fi
    else
      ln -s "$LAUNCHER" "$path" 2>/dev/null || true
    fi
  done
}

ensure_deps() {
  local miss="" pkgs="" c p
  for c in curl tar sha256sum; do
    command -v "$c" >/dev/null 2>&1 || { miss="$miss $c"; [ "$c" = "sha256sum" ] && p=coreutils || p=$c; pkgs="$pkgs $p"; }
  done
  if [ "$TERMUX" = 1 ]; then
    [ -x "$GLIBC_LD" ] || { miss="$miss glibc"; pkgs="$pkgs glibc"; }
    command -v patchelf >/dev/null 2>&1 || { miss="$miss patchelf"; pkgs="$pkgs patchelf"; }
  fi
  [ -z "$miss" ] && return 0
  pkgs=$(printf '%s\n' $pkgs | awk '!seen[$0]++' | tr '\n' ' ')
  pkgs=${pkgs% }
  if [ "$TTY" != 1 ] || [ "$ASSUME_YES" = 1 ]; then
    die "Missing:${miss}." "Install: pkg install -y $pkgs"
  fi
  menu_select "Missing:${miss}" \
    "Install ($pkgs)" \
    "Cancel"
  [ "$MENU_RESULT" = 0 ] || die "Cancelled: without these packages the install cannot proceed."
  command -v pkg >/dev/null 2>&1 || die "pkg not found — install manually: $pkgs"
  pkg install -y $pkgs || die "pkg install failed."
  # refresh paths once after installing
  hash -r 2>/dev/null || true
}

install_new() { # $1 = ready binary, $2 = version
  local new="$1" ver="$2" old_size=0 keep_backup=0
  mkdir -p "$OC_DIR" 2>/dev/null || true

  if [ -e "$REAL" ]; then
    case "$BACKUP_MODE" in
      yes) keep_backup=1 ;;
      no)  keep_backup=0 ;;
      *)
        if [ "$ASSUME_YES" = 1 ] || [ "$TTY" != 1 ]; then
          keep_backup=0
        else
        old_size=$(stat -c%s "$REAL" 2>/dev/null || echo 0)
        menu_select "Keep a backup of the current version?" \
          "No — save disk space" \
          "Yes — copy $(fmt_size "$old_size")"
        if [ "$MENU_RESULT" = -1 ]; then printf '\n  %sCancelled%s\n\n' "$DIM" "$RST"; exit 130; fi
        [ "$MENU_RESULT" = 1 ] && keep_backup=1 || keep_backup=0
        fi
        ;;
    esac
  fi

  if [ -e "$REAL" ]; then ln -f "$REAL" "$OC_DIR/.rollback" 2>/dev/null || cp -f "$REAL" "$OC_DIR/.rollback"; fi
  mv -f "$new" "$REAL" || die "Failed to replace $REAL"
  chmod 700 "$REAL"

  local got
  got=$(env -u LD_PRELOAD "$REAL" --version 2>/dev/null | awk 'NR==1 {print $2}')
  got="${got#v}"
  if [ "$got" != "$ver" ]; then
    if [ -e "$OC_DIR/.rollback" ]; then mv -f "$OC_DIR/.rollback" "$REAL"; fi
    die "The new version did not start (got: ${got:-error}); the old one was restored."
  fi

  if [ "$keep_backup" = 1 ] && [ -e "$OC_DIR/.rollback" ]; then
    mv -f "$OC_DIR/.rollback" "$BACKUP"
    BACKUP_MADE=1
  else
    rm -f "$OC_DIR/.rollback"
  fi
  printf '%s' "$ver" > "$VERSION_FILE"
  write_launcher
  link_commands
}

restart_service() {
  if ps -ef 2>/dev/null | grep -F "$REAL serve --service" | grep -qv grep; then
    printf '  %s↻%s Restarting the service…\n' "$CY" "$RST"
    env -u LD_PRELOAD "$REAL" service restart >/dev/null 2>&1 \
      && printf '  %s✔%s Service restarted\n' "$GR" "$RST" \
      || printf '  %s!%s Restart failed, run manually: opencode2 service restart\n' "$YL" "$RST"
  fi
}

# ---------- short names to launch OpenCode ----------
oc_version() {
  if [ -f "$VERSION_FILE" ]; then printf 'v%s' "$(cat "$VERSION_FILE" 2>/dev/null)"; else printf 'OpenCode'; fi
}

is_launch_alias() { # $1 = path; success if it is a symlink to the launcher OpenCode
  [ -L "$1" ] || return 1
  [ -n "$(readlink -f "$1" 2>/dev/null)" ] || return 1
  [ "$(readlink -f "$1" 2>/dev/null)" = "$(readlink -f "$LAUNCHER" 2>/dev/null)" ]
}

alias_list() { # names of all launcher symlinks, one per line
  local p
  for p in "$BIN_DIR"/*; do
    [ -L "$p" ] || continue
    is_launch_alias "$p" && basename "$p"
  done
}

alias_show() {
  local name found=0
  printf '  %sOpenCode launchers:%s\n' "$BOLD" "$RST"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    found=1
    case "$name" in
      opencode|opencode2) printf '  %s✔%s %-14s %s(built-in)%s\n' "$GR" "$RST" "$name" "$DIM" "$RST" ;;
      *)                  printf '  %s✔%s %-14s %s→ %s%s\n' "$GR" "$RST" "$name" "$DIM" "$(oc_version)" "$RST" ;;
    esac
  done <<EOF
$(alias_list)
EOF
  [ "$found" = 1 ] || printf '  %s○%s none yet — create one: %s --alias set %s\n' "$DIM" "$RST" "$PROG" "$ALIAS_DEFAULT"
}

alias_set() {
  local name="${1:-$ALIAS_DEFAULT}" p kind
  case "$name" in
    *[!A-Za-z0-9._-]*) die "Invalid name: '$name'." "Allowed: letters, digits, dot, hyphen and underscore." ;;
    -*|.*)             die "The name cannot start with '-' or '.'." ;;
  esac
  case "$name" in
    opencode|opencode2|opencode-v1|upopencode|upoc|opencode-browser)
      die "The name $name is reserved — choose another." "For example: $PROG --alias set oc" ;;
  esac
  [ -x "$LAUNCHER" ] || die "OpenCode is not installed." "Run first: $PROG"
  p="$BIN_DIR/$name"
  if [ -L "$p" ]; then
    if is_launch_alias "$p"; then
      printf '  %s✔%s %s already launches OpenCode (%s)\n' "$GR" "$RST" "$name" "$(oc_version)"
      return 0
    fi
    die "The name $name is already taken." "$(ls -ld "$p" 2>/dev/null)"
  elif [ -e "$p" ]; then
    die "The name $name is already taken." "$(ls -ld "$p" 2>/dev/null)"
  fi
  # a name shadowed by a builtin or another binary is useless
  kind=$(type -t "$name" 2>/dev/null)
  if [ -n "$kind" ] && [ "$kind" != "file" ]; then
    die "«$name» is a shell $kind and would shadow the alias." \
        "Choose another name, e.g.: $PROG --alias set oc"
  fi
  if command -v "$name" >/dev/null 2>&1; then
    die "Command $name already exists: $(command -v "$name")"
  fi
  mkdir -p "$BIN_DIR" 2>/dev/null || true
  ln -s "$LAUNCHER" "$p" || die "Failed to create $p (permissions?)"
  printf '  %s✔%s %s → OpenCode %s\n' "$GR" "$RST" "$name" "$(oc_version)"
  printf '     run: %s%s%s\n' "$BOLD" "$name" "$RST"
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) printf '  %s!%s %s is not in PATH — add: export PATH="%s:$PATH"\n' "$YL" "$RST" "$BIN_DIR" "$BIN_DIR" ;;
  esac
}

alias_remove() {
  local name="${1:-}" p removed=0
  if [ -z "$name" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      case "$name" in opencode|opencode2) continue ;; esac
      p="$BIN_DIR/$name"
      is_launch_alias "$p" || continue
      rm -f "$p" && { printf '  %s✔%s removed: %s\n' "$GR" "$RST" "$name"; removed=1; }
    done <<EOF
$(alias_list)
EOF
    [ "$removed" = 1 ] || printf '  %s○%s nothing to delete\n' "$DIM" "$RST"
    return 0
  fi
  case "$name" in
    opencode|opencode2) die "Not touching $name — reserved name." ;;
  esac
  p="$BIN_DIR/$name"
  if is_launch_alias "$p"; then
    rm -f "$p" && printf '  %s✔%s removed: %s\n' "$GR" "$RST" "$name"
  elif [ -e "$p" ] || [ -L "$p" ]; then
    die "Not touching $name — it is not an OpenCode alias." "$(ls -ld "$p" 2>/dev/null)"
  else
    printf '  %s○%s %s does not exist\n' "$DIM" "$RST" "$name"
  fi
}


# ---------- updater self-update ----------
self_update() {
  local url="$RAW_BASE/$PROG" tmp ver
  printf '\n  %s⬢%s  %supopencode%s · self-update\n\n' "$MG" "$RST" "$BOLD" "$RST"
  STEP=0; STEPS=2

  step_start "Checking the updater version"
  http_get "$url"
  if [ "$HTTP_RC" != 0 ] || [ -z "$HTTP_BODY" ]; then
    step_fail "no response"
    die "Failed to download $url" "Check your network or open https://github.com/$GH_SLUG"
  fi
  ver=$(printf '%s\n' "$HTTP_BODY" | grep -m1 '^SELF_VERSION=' | cut -d'"' -f2)
  case "$ver" in
    ''|*[!0-9.]*) step_fail "not an upopencode script"; die "GitHub returned something that is not the updater script." ;;
  esac
  step_ok "v$ver"

  if ! version_gt "$ver" "$SELF_VERSION" && [ "$FORCE" = 0 ]; then
    printf '\n  %s✦%s The updater is already up to date %sv%s%s\n\n' "$MG" "$RST" "$BOLD" "$SELF_VERSION" "$RST"
    return 0
  fi

  step_start "Installing v$ver"
  tmp=$(mktemp "$TMP_BASE/upopencode.self.XXXXXX" 2>/dev/null) || die "No space for a temp file in $TMP_BASE"
  printf '%s\n' "$HTTP_BODY" > "$tmp" || { rm -f "$tmp"; die "Failed to write $tmp"; }
  if [ "$TERMUX" = 1 ]; then            # Termux: bash path instead of /usr/bin/env
    sed -i "1s|.*|#!$PREFIX/bin/bash|" "$tmp"
  fi
  chmod 755 "$tmp"
  [ -d "$BIN_DIR" ] || mkdir -p "$BIN_DIR" 2>/dev/null
  install -m 755 "$tmp" "$SELF_BIN" || { rm -f "$tmp"; die "Failed to write $SELF_BIN (permissions?)"; }
  rm -f "$tmp"
  case "$PROG" in
    upopencode-ru) ln -sfn "$SELF_BIN" "$BIN_DIR/upoc-ru" 2>/dev/null || true ;;
    *)             ln -sfn "$SELF_BIN" "$BIN_DIR/upoc" 2>/dev/null || true ;;
  esac
  step_ok "v$ver"

  printf '\n'
  box_top "Updated"
  box_row "$(printf '%sUpdater:%s %sv%s%s → %sv%s%s' "$BOLD" "$RST" "$DIM" "$SELF_VERSION" "$RST" "$GR$BOLD" "$ver" "$RST")"
  box_row "$(printf 'File: %s' "$SELF_BIN")"
  box_bottom
  printf '\n'
}

# ---------- uninstall ----------
remove_aliases() { # $1 = all | keep-service; removes symlinks that launch OpenCode
  local n p
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    case "$n" in
      opencode-v1) continue ;;                      # this is a separate v1, leave it alone
      opencode|opencode2) [ "${1:-all}" = "all" ] || continue ;;
    esac
    p="$BIN_DIR/$n"
    if [ -L "$p" ] && [ "$(readlink -f "$p" 2>/dev/null)" = "$(readlink -f "$LAUNCHER" 2>/dev/null)" ]; then
      rm -f "$p" && printf '  %s✔%s removed: %s\n' "$GR" "$RST" "$n"
    fi
  done <<EOF
$(alias_list)
EOF
}

uninstall_updater() { # remove only upopencode, keep OpenCode
  printf '\n  %s⬢%s  %supopencode%s · uninstall\n\n' "$MG" "$RST" "$BOLD" "$RST"
  printf '  %sWill be removed:%s upopencode, its short names and aliases.\n' "$BOLD" "$RST"
  printf '  %sWill be kept:%s OpenCode v2, settings, sessions and data.\n\n' "$BOLD" "$RST"

  if [ "$TTY" = 1 ] && [ "$ASSUME_YES" = 0 ]; then
    menu_select "Remove upopencode?" \
      "Yes, remove upopencode" \
      "No, cancel"
    if [ "$MENU_RESULT" != 0 ]; then
      printf '  %sCancelled%s\n\n' "$DIM" "$RST"
      return 0
    fi
  elif [ "$ASSUME_YES" = 0 ]; then
    die "No terminal to confirm." "Run: $PROG --uninstall --yes"
  fi

  # aliases are shortcuts to OpenCode, they belong to the updater
  remove_aliases keep-service
  # short service names and both builds
  for n in upoc upoc-ru upopencode upopencode-ru; do
    p="$BIN_DIR/$n"
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -f "$p" && printf '  %s✔%s removed: %s\n' "$GR" "$RST" "$n"
    fi
  done
  # abandoned temp directories
  rm -rf "$TMP_BASE"/upopencode.* 2>/dev/null

  printf '\n'
  box_top "Removed"
  box_row "$(printf 'upopencode is gone')"
  box_row "$(printf '%sOpenCode, data and settings were not touched%s' "$DIM" "$RST")"
  box_bottom
  printf '\n'
}

uninstall_opencode() { # remove OpenCode v2, keep upopencode
  printf '\n  %s⬢%s  %supopencode%s · remove OpenCode\n\n' "$MG" "$RST" "$BOLD" "$RST"
  printf '  %sWill be removed:%s OpenCode v2, the launcher, opencode/opencode2 symlinks and aliases.\n' "$BOLD" "$RST"
  printf '  %sWill be kept:%s upopencode, settings, sessions and data.\n\n' "$BOLD" "$RST"

  if [ "$TTY" = 1 ] && [ "$ASSUME_YES" = 0 ]; then
    menu_select "Remove OpenCode v2?" \
      "Yes, remove OpenCode" \
      "No, cancel"
    if [ "$MENU_RESULT" != 0 ]; then
      printf '  %sCancelled%s\n\n' "$DIM" "$RST"
      return 0
    fi
  elif [ "$ASSUME_YES" = 0 ]; then
    die "No terminal to confirm." "Run: $PROG --uninstall-opencode --yes"
  fi

  remove_aliases all
  if [ -d "$OC_DIR" ]; then
    rm -rf "$OC_DIR" && printf '  %s✔%s removed: %s\n' "$GR" "$RST" "$OC_DIR"
  fi

  printf '\n'
  box_top "Removed"
  box_row "$(printf 'OpenCode v2, the launcher and aliases are gone')"
  box_row "$(printf '%supopencode, data and settings were kept%s' "$DIM" "$RST")"
  box_bottom
  printf '\n'
}

# ---------- main flow ----------
if [ "$SELF_UPDATE" = 1 ]; then
  self_update
  exit 0
fi

if [ "$UNINSTALL" = 1 ]; then
  uninstall_updater
  exit 0
fi

if [ "$UNINSTALL_OC" = 1 ]; then
  uninstall_opencode
  exit 0
fi

if [ -n "$ALIAS_ACTION" ]; then
  case "$ALIAS_ACTION" in
    show)                 alias_show ;;
    set|add|create)       alias_set "$ALIAS_NAME" ;;
    remove|rm|del|delete) alias_remove "$ALIAS_NAME" ;;
    *)                    alias_set "$ALIAS_ACTION" ;;
  esac
  exit 0
fi

banner
printf '  %s%s · %s%s\n\n' "$DIM" "$(uname -m)" "$( [ "$TERMUX" = 1 ] && echo Termux/glibc || echo Linux )" "$RST"

if [ "$DO_CLEAN" = 1 ]; then
  do_clean
  [ "$CHECK" = 0 ] && [ "$DRYRUN" = 0 ] && exit 0
fi

[ "$TTY" = 1 ] && STEPS=7 || STEPS=7
[ "$CHECK" = 1 ] && STEPS=2

# clean up abandoned directories from past runs (older than an hour)
for _d in "$TMP_BASE"/upopencode.*; do
  [ -d "$_d" ] || continue
  [ -n "$(find "$_d" -maxdepth 0 -mmin +60 2>/dev/null)" ] && rm -rf "$_d" 2>/dev/null
done
unset _d

[ "$TTY" = 1 ] && printf '\033[?25l'
TMP_DIR=$(mktemp -d "$TMP_BASE/upopencode.XXXXXX" 2>/dev/null) || die "Failed to create a temp directory in $TMP_BASE"
mkdir -p "$OC_DIR" 2>/dev/null || true

step_start "Reading the installed version"
installed_version
if [ "$BROKEN" = 1 ]; then
  MODE="repair"; step_ok "installation is broken — will reinstall"
elif [ -z "$CUR_VER" ]; then
  MODE="fresh";  step_ok "not installed — will do a fresh install"
elif [ "${CUR_VER%%.*}" = "1" ]; then
  MODE="v1";     step_ok "v$CUR_VER (v1) — will upgrade to v2"
else
  MODE="update"; step_ok "v$CUR_VER"
fi

step_start "Checking the latest release"
_T0=$SECONDS
LATEST_VER=$(latest_version)
if [ -z "$LATEST_VER" ] && [ $((SECONDS - _T0)) -lt 20 ]; then   # fast failure — retry once
  sleep 2
  LATEST_VER=$(latest_version)
fi
if [ -z "$LATEST_VER" ]; then
  step_fail "no response from npm/GitHub"
  die "Could not determine the latest version — looks like a network/DNS problem." \
"Check manually:
    curl -I $NPM_DIST_TAGS
    curl -I https://github.com/${REPO}/releases.atom
If curl works, just run it again (a brief glitch is possible)."
fi
step_ok "v$LATEST_VER"

if [ "$MODE" != "update" ]; then
  UPDATE=1
elif version_gt "$LATEST_VER" "$CUR_VER"; then
  UPDATE=1
elif [ "$FORCE" = 1 ]; then
  UPDATE=1
else
  UPDATE=0
fi

if [ "$UPDATE" = 0 ] && [ "$CHECK" = 0 ]; then
  printf '\n  %s✦%s You already have the latest version %sv%s%s\n\n' "$MG" "$RST" "$BOLD" "$CUR_VER" "$RST"
  exit 0
fi

if [ "$CHECK" = 1 ]; then
  printf '\n'
  if [ "$UPDATE" = 1 ]; then
    case "$MODE" in
      fresh)  box_top "OpenCode is not installed"
              box_row "$(printf 'can install: %sv%s%s' "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
      repair) box_top "Installation is broken"
              box_row "$(printf 'reinstall to: %sv%s%s' "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
      v1)     box_top "v2 upgrade available"
              box_row "$(printf '%sv%s%s (v1)  →  %sv%s%s' "$BOLD" "$CUR_VER" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
      *)      box_top "Update available"
              box_row "$(printf '%sv%s%s  →  %sv%s%s' "$BOLD" "$CUR_VER" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
    esac
    box_bottom
    printf '\n'
  else
    printf '  %s✔%s Latest version installed: %sv%s%s\n\n' "$GR" "$RST" "$BOLD" "$CUR_VER" "$RST"
  fi
  exit 0
fi

# --- preview and confirmation ---
R_DATE=$(release_date "$LATEST_VER" 2>/dev/null)
ASSET_URL="https://github.com/${REPO}/releases/download/v${LATEST_VER}/${ASSET}"

ASSET_BYTES=$(curl -fsIL --connect-timeout 10 --retry 2 "$ASSET_URL" 2>/dev/null | tr -d '\r' \
              | awk 'tolower($1)=="content-length:" {v=$2} END {print v}')
case "$ASSET_BYTES" in ''|*[!0-9]*) ASSET_BYTES=0 ;; esac
if [ "$ASSET_BYTES" = 0 ]; then
  die "Release v$LATEST_VER has no $ASSET" "Check https://github.com/${REPO}/releases/tag/v${LATEST_VER}"
fi

FREE_KB=$(free_kb "$OC_DIR"); FREE_KB=${FREE_KB:-0}
if [ "$TERMUX" = 1 ]; then
  # peak: archive + extracted binary, then new + old (archive already deleted)
  NEED_KB=$(( ASSET_BYTES/1024 * 45 / 10 + 30720 ))
  # a fresh Termux has no glibc — pkg install takes space too
  [ -x "$GLIBC_LD" ] || NEED_KB=$(( NEED_KB + 153600 ))
else
  NEED_KB=$(( ASSET_BYTES/1024 * 3 + 20480 ))
fi

space_box() {
  local vline date_sfx=""
  [ -n "$R_DATE" ] && date_sfx="   ($R_DATE)"
  case "$MODE" in
    fresh)  box_top "Install"
            vline=$(printf '%snot installed%s  →  %sv%s%s%s' "$DIM" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST" "$date_sfx") ;;
    repair) box_top "Reinstall"
            vline=$(printf '%sbroken%s  →  %sv%s%s%s' "$DIM" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST" "$date_sfx") ;;
    v1)     box_top "Upgrade to v2"
            vline=$(printf '%sv%s%s %s(v1)%s  →  %sv%s%s%s' "$BOLD" "$CUR_VER" "$RST" "$DIM" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST" "$date_sfx") ;;
    *)      box_top "Update"
            vline=$(printf '%sv%s%s  →  %sv%s%s%s' "$BOLD" "$CUR_VER" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST" "$date_sfx") ;;
  esac
  box_row "$vline"
  box_row "$(printf 'Package: %s   Size: %s' "$ASSET_SHORT" "$(fmt_size "$ASSET_BYTES")")"
  box_row "$(printf 'Free: %s' "$(fmt_size $((FREE_KB*1024)))")"
  box_row "$(printf 'Needed: ~%s' "$(fmt_size $((NEED_KB*1024)))")"
  if [ "$FREE_KB" -ge "$NEED_KB" ]; then
    box_row "$(printf '%senough space%s' "$GR" "$RST")"
  else
    box_row "$(printf '%snot enough space%s' "$RD" "$RST")"
  fi
  box_bottom
  printf '\n'
}
space_box

if [ "$FREE_KB" -lt "$NEED_KB" ]; then
  if [ "$DRYRUN" = 1 ]; then
    printf '  %s!%s Short by ~%s — free some space first (%s --clean)%s\n\n' \
      "$YL" "$RST" "$(fmt_size $(( (NEED_KB-FREE_KB)*1024 )))" "$PROG" "$RST"
    printf '  %s(dry-run) download and install steps skipped%s\n\n' "$DIM" "$RST"
    exit 0
  fi
  if [ "$TTY" = 1 ] && [ "$ASSUME_YES" = 0 ]; then
    menu_select "Not enough space — try to free some?" \
      "Yes, delete old backups/temp files" \
      "No, exit"
    if [ "$MENU_RESULT" = 0 ]; then
      do_clean 1
      FREE_KB=$(free_kb "$OC_DIR"); FREE_KB=${FREE_KB:-0}
      space_box
    else
      printf '  %sCancelled%s\n\n' "$DIM" "$RST"
      exit 0
    fi
  fi
  [ "$FREE_KB" -ge "$NEED_KB" ] || die "Not enough space." "Free ~$(fmt_size $(( (NEED_KB-FREE_KB)*1024 ))) and run again, or: $PROG --clean"
fi

if [ "$DRYRUN" = 1 ]; then
  printf '  %s(dry-run) download and install steps would run up to here%s\n\n' "$DIM" "$RST"
  exit 0
fi

if [ "$TTY" = 1 ] && [ "$ASSUME_YES" = 0 ]; then
  case "$MODE" in
    fresh)  menu_select "Install OpenCode v$LATEST_VER?" \
              "Yes, download and install" "No, cancel" ;;
    v1)     menu_select "Upgrade from v$CUR_VER to v$LATEST_VER?" \
              "Yes, install v2 (v1 stays as opencode-v1)" "No, stay on v1" ;;
    *)      menu_select "Update OpenCode?" \
              "Yes, update to v$LATEST_VER" "No, cancel" ;;
  esac
  if [ "$MENU_RESULT" != 0 ]; then printf '  %sCancelled%s\n\n' "$DIM" "$RST"; exit 0; fi
elif [ "$ASSUME_YES" = 0 ]; then
  die "No interactive terminal." "Run with $PROG --yes to install without menus."
fi

ensure_deps

# --- download ---
step_start "Downloading package"
download_asset "$ASSET_URL" "$TMP_DIR/$ASSET"
step_ok "$(fmt_size "${DOWNLOADED_BYTES:-0}")"

# --- checksum ---
step_start "Verifying SHA-256"
curl -fsSL --connect-timeout 10 --retry 2 -o "$TMP_DIR/SHA256SUMS" \
  "https://github.com/${REPO}/releases/download/v${LATEST_VER}/SHA256SUMS" 2>/dev/null \
  || { step_fail "SHA256SUMS download failed"; die "Incomplete release: no SHA256SUMS"; }
EXPECTED=$(awk -v f="$ASSET" '$2==f {print $1}' "$TMP_DIR/SHA256SUMS")
[ -n "$EXPECTED" ] || { step_fail "no hash for $ASSET"; die "SHA256SUMS has no $ASSET"; }
ACTUAL=$(sha256sum "$TMP_DIR/$ASSET" | awk '{print $1}')
[ "$EXPECTED" = "$ACTUAL" ] || { step_fail "hash mismatch"; die "Checksum mismatch — the file is corrupted."; }
step_ok "ok"

# --- extract and patch ---
step_start "Extracting and preparing the binary"
mkdir -p "$TMP_DIR/x"
tar -xzf "$TMP_DIR/$ASSET" -C "$TMP_DIR/x" opencode 2>/dev/null || { step_fail "tar"; die "Failed to extract the archive."; }
[ -f "$TMP_DIR/x/opencode" ] || { step_fail "no file"; die "The archive has no opencode binary."; }
chmod 700 "$TMP_DIR/x/opencode"
if [ "$TERMUX" = 1 ]; then
  patchelf --set-interpreter "$GLIBC_LD" "$TMP_DIR/x/opencode" 2>"$TMP_DIR/patchelf.err" \
    || { step_fail "patchelf"; die "Failed to patch the interpreter." "$(tail -3 "$TMP_DIR/patchelf.err")"; }
fi
NEW_RUN=$(probe_version "$TMP_DIR/x/opencode")
[ "$NEW_RUN" = "$LATEST_VER" ] || { step_fail "does not start"; die "The downloaded binary did not start (version: ${NEW_RUN:-error})."; }
# archive is no longer needed: free ~112 MB before replacing the old binary
rm -f "$TMP_DIR/$ASSET" "$TMP_DIR/SHA256SUMS"
step_ok "v$NEW_RUN"

# --- install ---
step_start "Installing"
install_new "$TMP_DIR/x/opencode" "$LATEST_VER"
step_ok "$REAL"

step_start "Checking commands"
CMDS_OK=1
for c in opencode2 opencode; do
  p="$BIN_DIR/$c"
  [ -e "$p" ] || [ -L "$p" ] || continue
  v=$(probe_version "$p")
  [ "$v" = "$LATEST_VER" ] || CMDS_OK=0
done
[ "$CMDS_OK" = 1 ] || { step_fail "commands do not respond"; die "The update is installed but commands do not run. Check $LAUNCHER"; }
step_ok "opencode2, opencode"

rm -rf "$TMP_DIR"; TMP_DIR=""

printf '\n'
box_top "Done"
case "$MODE" in
  fresh)  box_row "$(printf '%sInstalled:%s %sv%s%s' "$BOLD" "$RST" "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
  v1)     box_row "$(printf '%sUpgraded to v2:%s v%s → %sv%s%s' "$BOLD" "$RST" "$CUR_VER" "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
  *)      box_row "$(printf '%sUpdated:%s %s → %sv%s%s' "$BOLD" "$RST" "$CUR_VER" "$GR$BOLD" "$LATEST_VER" "$RST")" ;;
esac
if [ "${BACKUP_MADE:-0}" = 1 ]; then
  box_row "$(printf 'Backup: %s' "$(basename "$BACKUP")")"
else
  box_row "$(printf '%sBackup: not created%s' "$DIM" "$RST")"
fi
box_bottom
printf '\n'

case "$MODE" in
  fresh)
    printf '  %s✦%s Ready. Run: %sopencode%s\n' "$MG" "$RST" "$BOLD" "$RST"
    printf '    (or %sopencode2%s — the same thing)\n\n' "$DIM" "$RST" ;;
  v1)
    printf '  %s✦%s Now %sopencode%s runs v2. The old v1 is still available: %sopencode-v1%s\n\n' \
      "$MG" "$RST" "$BOLD" "$RST" "$BOLD" "$RST" ;;
esac

if ps -ef 2>/dev/null | grep -F "$REAL serve --service" | grep -qv grep; then
  if [ "$RESTART" = 1 ]; then
    restart_service
  else
    printf '  %s!%s The running service is still on the old version.\n' "$YL" "$RST"
    printf '    Restart it: %sopencode2 service restart%s\n\n' "$BOLD" "$RST"
  fi
fi
